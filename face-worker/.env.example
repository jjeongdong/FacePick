# 워커 노트북에서 실행할 때는 localhost 를 내 컴퓨터의 내부 IP(같은 와이파이) 또는 Tailscale IP 로 바꾼다
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_GROUP_ID=face-worker
TOPIC_PREVIEW_READY=photo.preview_ready
TOPIC_DLQ=photo.preview_ready.dlq
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=facepick
S3_SECRET_KEY=facepick-secret
S3_BUCKET=photos
DATABASE_URL=postgresql://facepick:facepick@localhost:5433/facepick
INSIGHTFACE_MODEL=buffalo_l
# 코사인 유사도. LFW 평가(uv run python -m face_worker.eval)로 정한 값
FACE_MATCH_THRESHOLD=0.45
FACE_KNN_K=5
# 미리보기(긴 변 2048px) 기준 얼굴 짧은 변 최소 px
FACE_MIN_SIZE=40
FACE_MIN_DET_SCORE=0.6
# --http 로 띄울 때 포트 (동기 방식 비교용). 백엔드 facepick.pipeline.face-url 과 맞춘다.
HTTP_PORT=8092
